{
  "js/ts.tsdk.path": "node_modules/typescript/lib",

  // TypeScript & TSX
  "[typescript]": {
    "editor.defaultFormatter": "biomejs.biome",
    "editor.formatOnSave": true
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "biomejs.biome",
    "editor.formatOnSave": true
  },

  // JSON with comments
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },

  // General Settings
  "editor.formatOnSave": true,
  "git.enableCommitSigning": true,
  "css.validate": false
}